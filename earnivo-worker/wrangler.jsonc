{
  "name": "earnivo-worker",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "AD_PROVIDER_ENABLED": "false",
    "AD_PROVIDER_VERIFY_URL": "",
    "ALLOWED_ORIGIN": "https://sahil16122134.github.io,https://earnivo.pages.dev",
    "ENVIRONMENT": "production"
  }
}